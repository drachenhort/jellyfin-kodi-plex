<?xml version="1.0" encoding="UTF-8"?>
<!-- Movie picker page (lib/windows/movie_picker.py), opened from Clean Up's
     "Select Movies…": every deletable movie in a two-column grid (600) with
     a check mark and the genres per row, and All Watched / Clear / Cancel / Done below. -->
<window>
  <defaultcontrol always="true">600</defaultcontrol>
  <controls>
    <control type="image">
      <posx>0</posx>
      <posy>0</posy>
      <width>1920</width>
      <height>1080</height>
      <texture>background.png</texture>
    </control>
    <control type="label">
      <posx>80</posx>
      <posy>60</posy>
      <width>1760</width>
      <height>60</height>
      <font>font32</font>
      <label>Select Movies to Delete</label>
    </control>
    <control type="label" id="601">
      <posx>80</posx>
      <posy>130</posy>
      <width>1760</width>
      <height>40</height>
      <font>font13</font>
      <textcolor>FFAAAAAA</textcolor>
      <label></label>
    </control>
    <control type="panel" id="600">
      <posx>80</posx>
      <posy>190</posy>
      <width>1760</width>
      <height>744</height>
      <orientation>vertical</orientation>
      <onleft>600</onleft>
      <onright>600</onright>
      <onup>600</onup>
      <ondown>602</ondown>
      <itemlayout width="880" height="124">
        <control type="image">
          <posx>12</posx>
          <posy>37</posy>
          <width>42</width>
          <height>42</height>
          <texture>button-nofocus.png</texture>
        </control>
        <control type="image">
          <posx>12</posx>
          <posy>37</posy>
          <width>42</width>
          <height>42</height>
          <texture>watched-badge.png</texture>
          <visible>String.IsEqual(ListItem.Property(checked),true)</visible>
        </control>
        <control type="image">
          <posx>68</posx>
          <posy>5</posy>
          <width>72</width>
          <height>106</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>8</posy>
          <width>690</width>
          <height>40</height>
          <font>font13</font>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>46</posy>
          <width>690</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFAAAAAA</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
          <visible>String.IsEmpty(ListItem.Property(unwatched))</visible>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>46</posy>
          <width>690</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFFFA500</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
          <visible>!String.IsEmpty(ListItem.Property(unwatched))</visible>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>80</posy>
          <width>690</width>
          <height>32</height>
          <font>font12</font>
          <textcolor>FF52B6C9</textcolor>
          <label>$INFO[ListItem.Property(genres)]</label>
        </control>
      </itemlayout>
      <focusedlayout width="880" height="124">
        <control type="image">
          <width>870</width>
          <height>116</height>
          <texture>button-focus.png</texture>
          <visible>Control.HasFocus(600)</visible>
        </control>
        <control type="image">
          <posx>12</posx>
          <posy>37</posy>
          <width>42</width>
          <height>42</height>
          <texture>button-nofocus.png</texture>
        </control>
        <control type="image">
          <posx>12</posx>
          <posy>37</posy>
          <width>42</width>
          <height>42</height>
          <texture>watched-badge.png</texture>
          <visible>String.IsEqual(ListItem.Property(checked),true)</visible>
        </control>
        <control type="image">
          <posx>68</posx>
          <posy>5</posy>
          <width>72</width>
          <height>106</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>8</posy>
          <width>690</width>
          <height>40</height>
          <font>font13</font>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>46</posy>
          <width>690</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFAAAAAA</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
          <visible>String.IsEmpty(ListItem.Property(unwatched))</visible>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>46</posy>
          <width>690</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFFFA500</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
          <visible>!String.IsEmpty(ListItem.Property(unwatched))</visible>
        </control>
        <control type="label">
          <posx>156</posx>
          <posy>80</posy>
          <width>690</width>
          <height>32</height>
          <font>font12</font>
          <textcolor>FF52B6C9</textcolor>
          <label>$INFO[ListItem.Property(genres)]</label>
        </control>
      </focusedlayout>
    </control>
    <control type="button" id="604">
      <posx>80</posx>
      <posy>960</posy>
      <width>300</width>
      <height>70</height>
      <font>font16</font>
      <align>center</align>
      <label>All Watched</label>
      <texturefocus border="10">focus-highlight.png</texturefocus>
      <texturenofocus>button-nofocus.png</texturenofocus>
      <onleft>604</onleft>
      <onright>605</onright>
      <onup>600</onup>
      <ondown>604</ondown>
    </control>
    <control type="button" id="605">
      <posx>400</posx>
      <posy>960</posy>
      <width>300</width>
      <height>70</height>
      <font>font16</font>
      <align>center</align>
      <label>Clear</label>
      <texturefocus border="10">focus-highlight.png</texturefocus>
      <texturenofocus>button-nofocus.png</texturenofocus>
      <onleft>604</onleft>
      <onright>603</onright>
      <onup>600</onup>
      <ondown>605</ondown>
    </control>
    <control type="button" id="603">
      <posx>1220</posx>
      <posy>960</posy>
      <width>300</width>
      <height>70</height>
      <font>font16</font>
      <align>center</align>
      <label>Cancel</label>
      <texturefocus border="10">focus-highlight.png</texturefocus>
      <texturenofocus>button-nofocus.png</texturenofocus>
      <onleft>605</onleft>
      <onright>602</onright>
      <onup>600</onup>
      <ondown>603</ondown>
    </control>
    <control type="button" id="602">
      <posx>1540</posx>
      <posy>960</posy>
      <width>300</width>
      <height>70</height>
      <font>font16</font>
      <align>center</align>
      <label>Done</label>
      <texturefocus border="10">focus-highlight.png</texturefocus>
      <texturenofocus>button-nofocus.png</texturenofocus>
      <onleft>603</onleft>
      <onright>602</onright>
      <onup>600</onup>
      <ondown>602</ondown>
    </control>
  </controls>
</window>
