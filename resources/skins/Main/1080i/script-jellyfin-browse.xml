<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">301</defaultcontrol>
  <controls>
    <control type="image">
      <posx>0</posx>
      <posy>0</posy>
      <width>1920</width>
      <height>1080</height>
      <texture>background.png</texture>
    </control>

    <control type="label" id="300">
      <posx>80</posx>
      <posy>40</posy>
      <width>1200</width>
      <height>50</height>
      <font>font32</font>
      <label></label>
    </control>

    <!-- Album screens only (BrowseWindow hides these otherwise): play every
         track in listing order, or in a shuffled order. -->
    <control type="button" id="302">
      <posx>1580</posx>
      <posy>45</posy>
      <width>140</width>
      <height>50</height>
      <font>font16</font>
      <label>Play All</label>
      <texturefocus border="10">focus-highlight.png</texturefocus>
      <texturenofocus>button-nofocus.png</texturenofocus>
      <onright>303</onright>
      <onleft>302</onleft>
      <ondown>301</ondown>
      <onup>302</onup>
    </control>
    <control type="button" id="303">
      <posx>1740</posx>
      <posy>45</posy>
      <width>140</width>
      <height>50</height>
      <font>font16</font>
      <label>Shuffle</label>
      <texturefocus border="10">focus-highlight.png</texturefocus>
      <texturenofocus>button-nofocus.png</texturenofocus>
      <onright>303</onright>
      <onleft>302</onleft>
      <ondown>301</ondown>
      <onup>303</onup>
    </control>

    <control type="panel" id="301">
      <posx>67</posx>
      <posy>90</posy>
      <width>1786</width>
      <height>720</height>
      <onup>302</onup>
      <itemgap>20</itemgap>
      <!-- Every child in both layouts below is offset +20/+13 from its
           natural position, reserving a blank margin around all four edges
           of the panel's own box (grown to make room) that's exactly the
           zoom overflow's reach, so the focused-cell grow in focusedlayout
           no longer gets clipped by the panel's own viewport edge for
           posters in the first/last visible row or the first/last column. -->
      <itemlayout width="220" height="330">
        <control type="image">
          <posx>13</posx>
          <posy>20</posy>
          <width>220</width>
          <height>330</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="image">
          <posx>13</posx>
          <posy>294</posy>
          <width>220</width>
          <height>56</height>
          <texture>gradient-overlay.png</texture>
          <visible>!String.IsEmpty(ListItem.Property(ratings_text))</visible>
        </control>
        <control type="label">
          <posx>23</posx>
          <posy>298</posy>
          <width>200</width>
          <height>20</height>
          <font>font12</font>
          <label>$INFO[ListItem.Property(ratings_text)]</label>
          <visible>!String.IsEmpty(ListItem.Property(ratings_text))</visible>
        </control>
        <control type="image">
          <posx>185</posx>
          <posy>28</posy>
          <width>40</width>
          <height>40</height>
          <texture>watched-badge.png</texture>
          <visible>ListItem.Property(watched)</visible>
        </control>
        <control type="image">
          <posx>21</posx>
          <posy>28</posy>
          <width>64</width>
          <height>40</height>
          <texture>unwatched-badge.png</texture>
          <visible>!String.IsEmpty(ListItem.Property(unwatched_count))</visible>
        </control>
        <control type="label">
          <posx>21</posx>
          <posy>28</posy>
          <width>64</width>
          <height>40</height>
          <font>font12</font>
          <align>center</align>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(unwatched_count)]</label>
          <visible>!String.IsEmpty(ListItem.Property(unwatched_count))</visible>
        </control>
      </itemlayout>
      <!-- Grows the focused cell to 112% via a bigger focusedlayout box
           (centered over the itemlayout footprint below with negative
           posx/posy), rather than a container-level Focus/UnFocus zoom
           animation - Panel controls (this is a multi-row/column grid,
           unlike the single-row Home/Search lists) apply that animation to
           the whole panel instead of just the focused cell. -->
      <focusedlayout width="246" height="370">
        <control type="image">
          <posx>0</posx>
          <posy>0</posy>
          <width>246</width>
          <height>370</height>
          <texture border="10">focus-highlight.png</texture>
        </control>
        <control type="image">
          <posx>3</posx>
          <posy>4</posy>
          <width>240</width>
          <height>363</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="image">
          <posx>3</posx>
          <posy>300</posy>
          <width>240</width>
          <height>70</height>
          <texture>focus-turquoise.png</texture>
        </control>
        <control type="label">
          <posx>14</posx>
          <posy>306</posy>
          <width>217</width>
          <height>24</height>
          <font>font12</font>
          <label>$INFO[ListItem.Property(ratings_text)]</label>
          <visible>!String.IsEmpty(ListItem.Property(ratings_text))</visible>
          <scroll>true</scroll>
        </control>
        <control type="label">
          <posx>0</posx>
          <posy>332</posy>
          <width>246</width>
          <height>38</height>
          <font>font12</font>
          <align>center</align>
          <label>$INFO[ListItem.Label]</label>
          <scroll>true</scroll>
        </control>
        <!-- Top and bottom copies of the same marker: whichever grid row
             the focused poster is in, the top arrow can end up clipped by
             the panel's own viewport edge (e.g. the top row), so the bottom
             one guarantees the selection is always visible somewhere. -->
        <control type="image">
          <posx>103</posx>
          <posy>0</posy>
          <width>40</width>
          <height>25</height>
          <texture>focus-arrow.png</texture>
        </control>
        <control type="image">
          <posx>103</posx>
          <posy>370</posy>
          <width>40</width>
          <height>25</height>
          <texture flipy="true">focus-arrow.png</texture>
        </control>
        <control type="image">
          <posx>188</posx>
          <posy>32</posy>
          <width>45</width>
          <height>45</height>
          <texture>watched-badge.png</texture>
          <visible>ListItem.Property(watched)</visible>
        </control>
        <control type="image">
          <posx>9</posx>
          <posy>32</posy>
          <width>72</width>
          <height>45</height>
          <texture>unwatched-badge.png</texture>
          <visible>!String.IsEmpty(ListItem.Property(unwatched_count))</visible>
        </control>
        <control type="label">
          <posx>9</posx>
          <posy>32</posy>
          <width>72</width>
          <height>45</height>
          <font>font12</font>
          <align>center</align>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(unwatched_count)]</label>
          <visible>!String.IsEmpty(ListItem.Property(unwatched_count))</visible>
        </control>
      </focusedlayout>
    </control>

    <!-- A season's episodes get an "ls -l"-style detail list instead of the
         poster grid above - one row per episode (thumb, code, title,
         duration, watched state) is a lot more scannable than a wall of
         near-identical landscape thumbnails. BrowseWindow toggles which of
         301/304 is visible and populated based on parent_item_type. -->
    <control type="list" id="304">
      <posx>80</posx>
      <posy>130</posy>
      <width>1760</width>
      <height>660</height>
      <onup>302</onup>
      <itemgap>6</itemgap>
      <itemlayout width="1760" height="84">
        <control type="image">
          <posy>2</posy>
          <width>150</width>
          <height>80</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>165</posx>
          <width>85</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(episode_code)]</label>
        </control>
        <control type="label">
          <posx>260</posx>
          <width>850</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Title]</label>
        </control>
        <control type="label">
          <posx>1120</posx>
          <width>190</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(ratings_text)]</label>
          <visible>!String.IsEmpty(ListItem.Property(ratings_text))</visible>
        </control>
        <control type="label">
          <posx>1330</posx>
          <width>100</width>
          <height>84</height>
          <font>font13</font>
          <align>right</align>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Duration(mins)] min</label>
          <visible>Integer.IsGreater(ListItem.Duration,0)</visible>
        </control>
        <control type="label">
          <posx>1440</posx>
          <width>150</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(progress_text)]</label>
          <visible>!String.IsEmpty(ListItem.Property(progress_text))</visible>
        </control>
        <control type="image">
          <posx>1610</posx>
          <posy>22</posy>
          <width>40</width>
          <height>40</height>
          <texture>watched-badge.png</texture>
          <visible>ListItem.Property(watched)</visible>
        </control>
      </itemlayout>
      <focusedlayout width="1760" height="84">
        <control type="image">
          <width>1760</width>
          <height>84</height>
          <texture border="6">focus-highlight.png</texture>
        </control>
        <control type="image">
          <posx>4</posx>
          <posy>6</posy>
          <width>150</width>
          <height>80</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>169</posx>
          <width>85</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(episode_code)]</label>
        </control>
        <control type="label">
          <posx>264</posx>
          <width>840</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Title]</label>
        </control>
        <control type="label">
          <posx>1120</posx>
          <width>190</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(ratings_text)]</label>
          <visible>!String.IsEmpty(ListItem.Property(ratings_text))</visible>
        </control>
        <control type="label">
          <posx>1330</posx>
          <width>100</width>
          <height>84</height>
          <font>font13</font>
          <align>right</align>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Duration(mins)] min</label>
          <visible>Integer.IsGreater(ListItem.Duration,0)</visible>
        </control>
        <control type="label">
          <posx>1440</posx>
          <width>150</width>
          <height>84</height>
          <font>font13</font>
          <aligny>center</aligny>
          <label>$INFO[ListItem.Property(progress_text)]</label>
          <visible>!String.IsEmpty(ListItem.Property(progress_text))</visible>
        </control>
        <control type="image">
          <posx>1610</posx>
          <posy>22</posy>
          <width>40</width>
          <height>40</height>
          <texture>watched-badge.png</texture>
          <visible>ListItem.Property(watched)</visible>
        </control>
      </focusedlayout>
    </control>

    <!-- Synopsis pane for the focused item, whichever of the poster grid
         (301) or episode list (304) is currently active - only one is ever
         populated per screen instance, so concatenating both container refs
         is safe: the inactive one is always empty. No Python wiring needed
         beyond list_item() already calling setPlot(). Collapses to blank
         space rather than being hidden outright when there's no Overview.
         Also suppressed outright (via the Window.Property(parent_overview)
         half of each condition) whenever the static parent-overview pane
         below is showing instead, e.g. a series' seasons - a season's own
         Overview is almost always blank anyway, but this guards the rare
         case where it isn't, to avoid the two panes overlapping. -->
    <control type="label">
      <posx>80</posx>
      <posy>810</posy>
      <width>1760</width>
      <height>30</height>
      <font>font16</font>
      <label>$INFO[Container(301).ListItem.Label]$INFO[Container(304).ListItem.Label]</label>
      <visible>String.IsEmpty(Window.Property(parent_overview)) + [!String.IsEmpty(Container(301).ListItem.Plot) | !String.IsEmpty(Container(304).ListItem.Plot)]</visible>
    </control>
    <control type="textbox">
      <posx>80</posx>
      <posy>845</posy>
      <width>1760</width>
      <height>185</height>
      <font>font13</font>
      <label>$INFO[Container(301).ListItem.Plot]$INFO[Container(304).ListItem.Plot]</label>
      <visible>String.IsEmpty(Window.Property(parent_overview)) + [!String.IsEmpty(Container(301).ListItem.Plot) | !String.IsEmpty(Container(304).ListItem.Plot)]</visible>
    </control>

    <!-- Static synopsis of the parent item itself (e.g. the show, while
         still picking a season) rather than the focused child - a Window
         property set once in BrowseWindow.onInit() (see SUMMARIZED_PARENT_TYPES)
         rather than an $INFO container binding, since it doesn't change as
         focus moves through the grid. -->
    <control type="textbox">
      <posx>80</posx>
      <posy>810</posy>
      <width>1760</width>
      <height>220</height>
      <font>font13</font>
      <label>$INFO[Window.Property(parent_overview)]</label>
      <visible>!String.IsEmpty(Window.Property(parent_overview))</visible>
    </control>

    <!-- Transient loading overlay: shown while _load() is still fetching in
         the background so the screen doesn't read as frozen on a slow/large
         library, hidden once it finishes (lib/windows/browse.py). Placed
         last so it renders on top of everything else, centered on screen
         rather than docked in the header - the backdrop panel's visibility
         tracks the label control (305) directly rather than needing its own
         id/Python wiring. -->
    <control type="image">
      <posx>560</posx>
      <posy>495</posy>
      <width>800</width>
      <height>90</height>
      <texture colordiffuse="D0000000">white.png</texture>
      <visible>Control.IsVisible(305)</visible>
    </control>
    <control type="label" id="305">
      <posx>560</posx>
      <posy>495</posy>
      <width>800</width>
      <height>90</height>
      <font>font16</font>
      <align>center</align>
      <aligny>center</aligny>
      <label>Loading…</label>
    </control>
  </controls>
</window>
