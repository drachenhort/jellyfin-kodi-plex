          <posx>0</posx>
          <posy>40</posy>
          <width>1760</width>
          <height>135</height>
          <orientation>horizontal</orientation>
          <itemgap>20</itemgap>
          <onright>200</onright>
          <onleft>200</onleft>
          <onup>204</onup>
          <ondown>203</ondown>
          <itemlayout width="240" height="135">
            <control type="image">
              <width>240</width>
              <height>135</height>
              <aspectratio>scale</aspectratio>
              <texture>$INFO[ListItem.Art(thumb)]</texture>
            </control>
            <control type="image">
              <posy>95</posy>
              <width>240</width>
              <height>40</height>
              <texture>gradient-overlay.png</texture>
            </control>
            <control type="label">
              <posx>10</posx>
              <posy>105</posy>
              <width>220</width>
              <height>30</height>
              <font>font12</font>
              <label>$INFO[ListItem.Label]</label>
            </control>
          </itemlayout>
          <focusedlayout width="240" height="135">
            <!-- A List control renders its selected item with focusedlayout
                 regardless of whether the control itself currently has
                 input focus, so without this every row's remembered
                 selection would show as "focused" simultaneously - only the
                 border/arrow (the actual focus cue) are gated here since
                 the poster/label look the same either way. -->
            <control type="image">
              <width>240</width>
              <height>135</height>
              <texture border="10">focus-highlight.png</texture>
              <visible>Control.HasFocus(200)</visible>
