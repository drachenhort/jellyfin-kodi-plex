    <!-- Kodi's System.Time infolabel format tokens don't actually switch
         between 12/24-hour (that follows the OS/Kodi regional locale
         setting regardless of the format string) - only whether an am/pm
         suffix is appended. So the clock_24_hour setting couldn't be
         honored via a skin-only $INFO label; HomeWindow ticks this Window
         property with a plain Python-formatted string instead (see
         HomeWindow._tick_clock), independent of locale. -->
    <control type="label">
      <posx>1835</posx>
      <posy>45</posy>
      <width>110</width>
      <height>50</height>
      <font>font16</font>
      <align>left</align>
      <aligny>center</aligny>
      <label>$INFO[Window.Property(clock_text)]</label>
      <visible>String.IsEqual(Window.Property(show_clock),true)</visible>
    </control>

    <!-- Rows are stacked in a grouplist so it scrolls to keep the focused
         row visible instead of every row having to be squeezed to fit a
         fixed 1080px-tall screen.

         Every poster/thumb image uses <aspectratio>scale</aspectratio> so
         Jellyfin's real image shapes (portrait 2:3 posters for Movies/
         Series, landscape ~16:9 thumbs for Episodes) crop-to-fill their box
         instead of being stretched/distorted. Recently Added Movies/TV are
         both portrait boxes matching Movie/Series posters, sized the same
         as each other on request. Recently Added TV mixes newly-added
         Series (portrait, native fit) and Episodes (landscape, scale-crops
         to fill the portrait frame). -->
    <control type="grouplist" id="210">
      <posx>80</posx>
      <posy>110</posy>
      <width>1760</width>
      <height>900</height>
      <orientation>vertical</orientation>
      <itemgap>20</itemgap>
      <scrolltime tween="sine" easing="out">200</scrolltime>
      <onup>204</onup>

      <control type="group">
        <width>1760</width>
        <height>175</height>
        <visible>Integer.IsGreater(Container(200).NumItems,0)</visible>
        <control type="label">
