<?xml version="1.0" encoding="UTF-8"?>
<!-- Clean Up screen (lib/windows/cleanup.py): watched movies on the left
     (500), the to-be-deleted list on the right (501), and the Delete button
     (502) under it. Selecting a row moves it to the other list. -->
<window>
  <defaultcontrol always="true">500</defaultcontrol>
  <controls>
    <control type="image">
      <posx>0</posx>
      <posy>0</posy>
      <width>1920</width>
      <height>1080</height>
      <texture>background.png</texture>
    </control>
    <control type="label">
      <posx>80</posx>
      <posy>60</posy>
      <width>1200</width>
      <height>60</height>
      <font>font32</font>
      <label>Clean Up Watched Movies</label>
    </control>
    <control type="label" id="505">
      <posx>80</posx>
      <posy>130</posy>
      <width>1760</width>
      <height>40</height>
      <font>font13</font>
      <label></label>
    </control>
    <control type="label" id="503">
      <posx>80</posx>
      <posy>195</posy>
      <width>840</width>
      <height>45</height>
      <font>font16</font>
      <label></label>
    </control>
    <control type="label" id="504">
      <posx>1000</posx>
      <posy>195</posy>
      <width>840</width>
      <height>45</height>
      <font>font16</font>
      <label></label>
    </control>
    <control type="list" id="500">
      <posx>80</posx>
      <posy>250</posy>
      <width>840</width>
      <height>780</height>
      <itemgap>4</itemgap>
      <onleft>500</onleft>
      <onright>501</onright>
      <ondown>500</ondown>
      <onup>500</onup>
      <itemlayout width="840" height="90">
        <control type="image">
          <posx>10</posx>
          <posy>5</posy>
          <width>54</width>
          <height>80</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>8</posy>
          <width>740</width>
          <height>40</height>
          <font>font13</font>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>46</posy>
          <width>740</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFAAAAAA</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
        </control>
      </itemlayout>
      <focusedlayout width="840" height="90">
        <control type="image">
          <width>840</width>
          <height>90</height>
          <texture>button-focus.png</texture>
          <visible>Control.HasFocus(500)</visible>
        </control>
        <control type="image">
          <posx>10</posx>
          <posy>5</posy>
          <width>54</width>
          <height>80</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>8</posy>
          <width>740</width>
          <height>40</height>
          <font>font13</font>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>46</posy>
          <width>740</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFAAAAAA</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
        </control>
      </focusedlayout>
    </control>
    <control type="list" id="501">
      <posx>1000</posx>
      <posy>250</posy>
      <width>840</width>
      <height>660</height>
      <itemgap>4</itemgap>
      <onleft>500</onleft>
      <onright>502</onright>
      <ondown>502</ondown>
      <onup>501</onup>
      <itemlayout width="840" height="90">
        <control type="image">
          <posx>10</posx>
          <posy>5</posy>
          <width>54</width>
          <height>80</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>8</posy>
          <width>740</width>
          <height>40</height>
          <font>font13</font>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>46</posy>
          <width>740</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFAAAAAA</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
        </control>
      </itemlayout>
      <focusedlayout width="840" height="90">
        <control type="image">
          <width>840</width>
          <height>90</height>
          <texture>button-focus.png</texture>
          <visible>Control.HasFocus(501)</visible>
        </control>
        <control type="image">
          <posx>10</posx>
          <posy>5</posy>
          <width>54</width>
          <height>80</height>
          <aspectratio>scale</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>8</posy>
          <width>740</width>
          <height>40</height>
          <font>font13</font>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <posx>84</posx>
          <posy>46</posy>
          <width>740</width>
          <height>34</height>
          <font>font12</font>
          <textcolor>FFAAAAAA</textcolor>
          <label>$INFO[ListItem.Property(meta)]</label>
        </control>
      </focusedlayout>
    </control>
    <control type="button" id="502">
      <posx>1000</posx>
      <posy>940</posy>
      <width>840</width>
      <height>70</height>
      <font>font16</font>
      <align>center</align>
      <label>Nothing to delete</label>
      <texturefocus colordiffuse="FFC0392B">white.png</texturefocus>
      <texturenofocus>button-nofocus.png</texturenofocus>
      <onleft>500</onleft>
      <onup>501</onup>
      <ondown>502</ondown>
      <onright>502</onright>
    </control>
  </controls>
</window>
